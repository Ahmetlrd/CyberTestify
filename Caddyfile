# CyberTestify — Caddy reverse proxy + otomatik Let's Encrypt TLS.
# app  -> frontend (Next.js :3000)
# api  -> backend  (:4000)
# NOT: admin.cybertestify.com BILEREK yok — PentAGI paneli disariya ACILMAZ
# (yalniz SSH tuneli ile erisilir). Bu yuzden burada tanimlanmadi.

# Apex (cybertestify.com) -> app'e kalici (301) yonlendirme. {uri} ile yol korunur.
# Caddy bu site blogu icin Let's Encrypt sertifikasini da otomatik alir.
cybertestify.com {
	redir https://app.cybertestify.com{uri} permanent
}

app.cybertestify.com {
	encode gzip zstd
	reverse_proxy frontend:3000
}

api.cybertestify.com {
	encode gzip zstd
	reverse_proxy api:4000
}

# İç yönetim paneli — aynı Next.js frontend'inin /admin/* rotaları. Kök '/' -> login.
# Erişim API tarafında AYRI admin auth + (opsiyonel) ADMIN_IP_ALLOWLIST ile korunur;
# istenirse burada Caddy seviyesinde de IP kısıtı eklenebilir (remote_ip matcher).
admin.cybertestify.com {
	encode gzip zstd
	@root path /
	redir @root /admin/login permanent
	reverse_proxy frontend:3000
}
