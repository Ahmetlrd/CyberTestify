# CyberTestify backend ortam degiskenleri (ornek). Kopyalayin: cp .env.example .env
# NOT: dev'de PentAGI self-signed oldugu icin dev/worker scriptleri
# NODE_TLS_REJECT_UNAUTHORIZED=0 ile calisir (package.json). Prod'a TASINMAZ.

# --- Zorunlu ---
DATABASE_URL="postgresql://saas_user:changeme@localhost:5433/pentest_saas"
PENTAGI_GRAPHQL_URL="https://localhost:8443/api/v1/graphql"
PENTAGI_SERVICE_TOKEN=""          # PentAGI admin > API Tokens
# PentAGI Providers ekranindaki profil adi (createFlow'a birebir gider). Bos ise
# kod varsayilani 'cybertestify-anthropic' kullanilir.
PENTAGI_PROVIDER="cybertestify-anthropic"
JWT_SECRET=""                     # openssl rand -hex 32
REPORT_ENCRYPTION_PEPPER=""       # openssl rand -hex 32

# --- Genel ---
PORT=4000
FRONTEND_URL="http://localhost:3000"
DNS_VERIFICATION_PREFIX="pentest-verify"
LEGAL_VERSION="2026-07-26"        # hukuki metin surumu (rizalar bununla damgalanir)
REPORT_RETENTION_DAYS=30          # rapor icerigi bu sure sonunda silinir (siparis kaydi korunur)

# --- Odeme (bos = mock modu; gercek iyzico girilince otomatik gecer) ---
MOCK_PAYMENT=true
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --- Kapsam kilidi (SCOPE LOCK) — KRITIK ---
# Egress proxy <-> backend internal API sirri. PROD'DA MUTLAKA DEGISTIR.
INTERNAL_API_SECRET="dev-internal-secret-change-me"
EGRESS_PROXY_PORT=8899            # egress proxy dinleme portu (PentAGI PROXY_URL buraya)
EGRESS_PROXY_URL="http://localhost:8899"   # backend/worker'in proxy saglik kontrolu
BACKEND_INTERNAL_URL="http://localhost:4000" # proxy'nin backend internal endpoint'i
SCOPE_ENFORCEMENT="enforce"       # enforce | monitor
# SCOPE_ALLOWLIST="cve.mitre.org,nvd.nist.gov,github.com,..."  # bos = kod icindeki varsayilan
# Ham ag/port (networkLayer) paketleri ANCAK bu true iken ve bypass-proof
# izolasyon (internal:true network + dual-homed proxy) tamamlandiginda acilir.
HARDENED_NETWORK_ISOLATION=false

# PentAGI tarafinda (bu backend'de DEGIL, ~/Downloads/pentagi/.env'de) set edilmeli:
#   PROXY_URL=http://host.docker.internal:8899
#   DOCKER_NETWORK=pentagi-egress   (once: docker network create pentagi-egress)
